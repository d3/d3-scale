{
  "name": "d3-scale",
  "version": "4.0.2",
  "description": "Encodings that map abstract data to visual representation.",
  "homepage": "https://d3js.org/d3-scale/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-scale.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "scale",
    "visualization"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "https://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-scale.mjs",
  "main": "dist/d3-scale.mjs",
  "jsdelivr": "dist/d3-scale.min.js",
  "unpkg": "dist/d3-scale.min.js",
  "exports": {
    "umd": "./dist/d3-scale.min.js",
    "default": "./dist/d3-scale.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-array": "2.10.0 - 3",
    "d3-format": "1 - 3",
    "d3-interpolate": "1.2.0 - 3",
    "d3-time": "2.1.1 - 3",
    "d3-time-format": "2 - 4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "d3-color": "^3.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "rollup": "^4.67.4",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "TZ=America/Los_Angeles vitest",
    "lint": "eslint src test",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  }
}
